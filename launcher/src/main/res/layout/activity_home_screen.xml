<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.secureapplock.launcher.ui.view.Parallax3DView
        android:id="@+id/parallax_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/home_screen_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="4"
            android:rowCount="6"
            android:padding="16dp" />

    </com.secureapplock.launcher.ui.view.Parallax3DView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/lock_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔓 Layout Lock: OFF"
            android:textSize="14sp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/toggle_lock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle Lock" />

    </LinearLayout>

</LinearLayout>
